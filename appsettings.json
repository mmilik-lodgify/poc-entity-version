{
  "Database": {
    // "Postgres" or "SqlServer"
    "Provider": "Postgres"
  },
  "Simulation": {
    // "Broken" = Version is a plain column        -> shows the problem
    // "Fixed"  = Version is an EF concurrency token -> shows the solution
    "Mode": "Fixed",
    "BalanceId": 1,
    "InitialAmount": 1000,
    "Decrement": 10,
    "Workers": 100,
    "MaxAttemptsPerWorker": 1000,

    // Pod clock skew applied to the event PublishedAtUtc, in milliseconds (+/-)
    "ClockSkewMs": 250,
    // How many positions redelivery may displace a message from its publish order
    "DeliveryJitter": 5,
    // Seed for the clock skew and for the delivery reordering
    "Seed": 1234
  }
}
