{
  "Database": {
    // "Postgres" or "SqlServer"
    "Provider": "Postgres"
  },
  "Simulation": {
    // Which scenarios to run, in order, or "all":
    //   Unguarded       - Version is a plain column                    -> the problem
    //   Guarded         - Version is an EF concurrency token + retry   -> the solution
    //   AtomicIncrement - one SQL statement increments and returns it  -> the alternative
    "Scenarios": "all",

    "BalanceId": 1,
    "InitialAmount": 1000,
    "Decrement": 10,
    "Workers": 100,
    "MaxAttemptsPerWorker": 1000,

    // Pod clock skew applied to the event PublishedAtUtc, in milliseconds (+/-)
    "ClockSkewMs": 250,
    // How many positions redelivery may displace a message from its publish order
    "DeliveryJitter": 5,
    // Seed for the clock skew and for the delivery reordering
    "Seed": 1234,

    // Event log detail: "None", "Anomalies" or "All"
    "ShowEvents": "Anomalies",
    "EventContextRows": 5,
    "MaxNotableRows": 10
  }
}
