{
  "Database": {
    // "Postgres" or "SqlServer"
    "Provider": "Postgres"
  },
  "Simulation": {
    // Which scenarios to run, in order, or "all":
    //   TimestampOnly   - correct write, event carries only a timestamp  -> the problem
    //   Guarded         - same write, event also carries the version     -> the solution
    //   AtomicIncrement - version produced by one SQL statement instead  -> the alternative
    "Scenarios": "all",

    "BalanceId": 1,
    // Each worker takes this much out of the balance. The starting balance is Workers * Decrement, so a
    // correct run always ends on exactly 0 and anything left over is a lost write.
    "Decrement": 10,
    // 10 workers already lose 9 of 10 writes, and every event log stays short enough to read
    // whole. Raise it (100, 1000) to show how the cost of each strategy scales.
    "Workers": 10,
    "MaxAttemptsPerWorker": 1000,

    // Pod clock skew applied to the event PublishedAtUtc, in milliseconds (+/-)
    "ClockSkewMs": 1000,
    // How many positions redelivery may displace a message from its publish order
    "DeliveryJitter": 5,
    // Seed for the clock skew and for the delivery reordering
    "Seed": 1234,

    // Event log detail: "None", "Anomalies" or "All"
    "ShowEvents": "All",
    "EventContextRows": 5,
    "MaxNotableRows": 10
  }
}
